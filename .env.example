# Lumen environment configuration.
#
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env` — it is gitignored.
#
# All variables below are SERVER-ONLY. None are exposed to the browser.
# Lumen does not use any NEXT_PUBLIC_ variables.

# Base URL of your SearXNG instance. No trailing slash.
#   Local Docker:     http://localhost:8080
#   Home server:      http://192.168.1.10:8080
#   Remote host:      https://searxng.example.com
SEARXNG_URL=http://localhost:8080

# Optional. Bearer token if your SearXNG instance is behind an
# authenticated reverse proxy. SearXNG itself does not use this.
# SEARXNG_AUTH_SECRET=

# Optional. Override the request timeout (ms) when calling SearXNG.
# Default: 8000
# SEARXNG_TIMEOUT_MS=8000

# Optional. Max searches per minute per client IP (in-memory limiter).
# Default: 60
# LUMEN_RATE_LIMIT_PER_MINUTE=60

# Optional. TTL for the in-memory search cache (ms).
# Default: 60000
# LUMEN_CACHE_TTL_MS=60000
