# No third-party credentials required. Public API sources are keyless.
LUMEN_PORT=3000
LUMEN_BACKEND_URL=http://127.0.0.1:8000
# Server-side only; never use NEXT_PUBLIC_ for credentials.
CROSSREF_MAILTO=
# Internal proxy authentication, generated locally: python tools/configure.py
LUMEN_PROXY_SECRET=
# Set to 1 behind an HTTPS reverse proxy.
LUMEN_SECURE_COOKIES=0
# Diagnostics disabled until a token is configured.
LUMEN_DIAGNOSTICS_TOKEN=

# Bounded backend runtime tuning
LUMEN_CACHE_TTL_SECONDS=120
LUMEN_CACHE_MAX_ENTRIES=128
LUMEN_ENGINE_TIMEOUT_SECONDS=12
LUMEN_QUERY_TIMEOUT_SECONDS=15
LUMEN_MAX_OUTBOUND_CONCURRENCY=12
LUMEN_RATE_LIMIT_PER_MINUTE=120
LUMEN_PROXY_PEER_RATE_LIMIT_PER_MINUTE=2400

# Experimental, unofficial DuckDuckGo HTML; opt-in after reviewing provider terms.
LUMEN_ENABLE_DDG_HTML=0
# Retained RSS parser; disabled pending documented permission for automated access.
LUMEN_ENABLE_GOOGLE_NEWS_RSS=0
